generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId    String   @id @default(nanoid(8))
  name      String
  phoneNo   String   @unique
  emailId   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model OtpLog {
  referenceId String    @id
  phoneNo     String
  otp         String
  status      OtpStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  @@map("otp_logs")
}
